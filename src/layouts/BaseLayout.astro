---
import '../styles/global.css';
import { Analytics } from '@vercel/analytics/react';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  jsonLd?: string;
  isArticle?: boolean;
  publishedDate?: string;
  author?: string;
  articleImage?: string;
  breadcrumb?: string;
}
const {
  title,
  description,
  ogImage,
  jsonLd,
  breadcrumb,
} = Astro.props;

const siteUrl = Astro.url.origin;
const absOgImage = ogImage
  ? (ogImage.startsWith('http') ? ogImage : siteUrl + ogImage)
  : undefined;
const absArticleImage = Astro.props.articleImage
  ? (Astro.props.articleImage.startsWith('http') ? Astro.props.articleImage : siteUrl + Astro.props.articleImage)
  : undefined;

// JSON-LD: WebSite schema (pre-rendered to avoid template parser ambiguity)
const websiteSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'AI Playbook',
  url: siteUrl,
  description: 'In-depth AI tool reviews, hands-on tutorials, and practical workflows. We test, score, and compare so you can choose with confidence.',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: siteUrl + '/reviews?q={search_term_string}',
    },
    'query-input': 'required name=search_term_string',
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | AI Playbook</title>
    <meta name="description" content={description || 'In-depth AI tool reviews, tutorials, and workflows. Honest, practical, and data-driven.'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={Astro.url.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || 'In-depth AI tool reviews, tutorials, and workflows.'} />
    <meta property="og:type" content={Astro.props.isArticle ? 'article' : 'website'} />
    <meta property="og:url" content={Astro.url.href} />
    {absOgImage && <meta property="og:image" content={absOgImage} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={Astro.props.isArticle ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || 'In-depth AI tool reviews, tutorials, and workflows.'} />
    {absOgImage && <meta name="twitter:image" content={absOgImage} />}

    <!-- JSON-LD: WebSite Schema (site-wide) -->
    <script type="application/ld+json" set:html={websiteSchema} />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {breadcrumb && <script type="application/ld+json" set:html={breadcrumb} />}

    <!-- Inter Font -->
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased min-h-screen flex flex-col">
    <!-- Navigation -->
    <nav class="bg-white border-b border-gray-200 sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <a href="/" class="flex items-center gap-2 font-bold text-xl text-gray-900 no-underline">
            <span class="text-blue-600">AI</span>Playbook
          </a>
          <div class="hidden md:flex items-center gap-6 text-sm font-medium">
            <a href="/reviews" class="text-gray-600 hover:text-gray-900 transition-colors">Reviews</a>
            <a href="/tutorials" class="text-gray-600 hover:text-gray-900 transition-colors">Tutorials</a>
            <a href="/comparisons" class="text-gray-600 hover:text-gray-900 transition-colors">Comparisons</a>
            <a href="/categories" class="text-gray-600 hover:text-gray-900 transition-colors">Categories</a>
            <a href="/about" class="text-gray-600 hover:text-gray-900 transition-colors">About</a>
          </div>
        </div>
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-gray-500">
          <div>&copy; {new Date().getFullYear()} AI Playbook. Honest AI tool reviews.</div>
          <div class="flex gap-4">
            <a href="/about" class="hover:text-gray-700 transition-colors">About</a>
            <a href="/categories" class="hover:text-gray-700 transition-colors">Categories</a>
            <a href="/rss.xml" class="hover:text-gray-700 transition-colors">RSS</a>
          </div>
        </div>
      </div>
    </footer>
  <Analytics />
</body>
</html>
