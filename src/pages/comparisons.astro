---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';

const comparisons = await getCollection('comparisons');
const sorted = comparisons.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="Comparisons — AI Playbook" description="Head-to-head AI tool comparisons.">
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-2">Tool Comparisons</h1>
    <p class="text-gray-500 mb-8">Head-to-head comparisons to help you choose.</p>
    {sorted.length > 0 ? (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {sorted.map(c => <ArticleCard type="comparisons" item={c} />)}
      </div>
    ) : (
      <p class="text-gray-400">Coming soon.</p>
    )}
  </section>
</BaseLayout>
