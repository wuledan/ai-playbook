---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { getCategoryColor, getRatingColor, formatDate } from '../lib/utils';

const reviews = await getCollection('reviews');
const sortedReviews = reviews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestReviews = sortedReviews.slice(0, 5);

const categories = [...new Set(reviews.map(r => r.data.category))].sort();

const pageTitle = 'AI Playbook — Honest AI Tool Reviews & Tutorials';
---

<BaseLayout
  title={pageTitle}
  description="In-depth AI tool reviews, hands-on tutorials, and practical workflows. We test, score, and compare so you can choose with confidence."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-600 to-indigo-700 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight mb-4">
          Stop guessing. <span class="text-blue-200">Start knowing.</span>
        </h1>
        <p class="text-lg md:text-xl text-blue-100 mb-8 max-w-2xl">
          In-depth AI tool reviews backed by real testing. We rate every tool across 5 dimensions — so you can pick the right one in minutes, not days.
        </p>
        <div class="flex flex-wrap gap-3">
          <a href="/reviews" class="inline-flex items-center px-6 py-3 bg-white text-blue-700 font-semibold rounded-lg hover:bg-blue-50 transition-colors">
            Browse Reviews →
          </a>
          <a href="/tutorials" class="inline-flex items-center px-6 py-3 bg-blue-500/30 text-white font-semibold rounded-lg hover:bg-blue-500/40 transition-colors border border-blue-400/30">
            View Tutorials
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Bar -->
  <section class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex flex-wrap gap-2">
        {categories.map(cat => (
          <a href={`/reviews/category/${cat.toLowerCase().replace(/\s+/g, '-')}`}
             class={`px-3 py-1.5 rounded-full text-sm font-medium transition-colors ${getCategoryColor(cat)}`}>
            {cat}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Reviews -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900">Latest Reviews</h2>
      <a href="/reviews" class="text-blue-600 hover:text-blue-700 text-sm font-semibold">View all →</a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {latestReviews.map(review => (
        <article class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg transition-shadow group">
          <a href={`/reviews/${review.slug}`} class="block">
            <div class="aspect-video bg-gray-100 flex items-center justify-center">
              {review.data.cover ? (
                <img src={review.data.cover} alt={review.data.title} class="w-full h-full object-cover" />
              ) : (
                <span class="text-gray-400 text-sm">Cover image</span>
              )}
            </div>
            <div class="p-5">
              <div class="flex items-center gap-2 mb-2">
                <span class={`px-2 py-0.5 rounded text-xs font-medium ${getCategoryColor(review.data.category)}`}>
                  {review.data.category}
                </span>
                <span class={`ml-auto px-2 py-0.5 rounded text-white text-xs font-bold ${getRatingColor(review.data.rating)}`}>
                  {review.data.rating}
                </span>
              </div>
              <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors mb-2 line-clamp-2">
                {review.data.title}
              </h3>
              <p class="text-sm text-gray-500 mb-3 line-clamp-2">
                {review.data.meta_description}
              </p>
              <time class="text-xs text-gray-400">{formatDate(review.data.date)}</time>
            </div>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 mb-8">
    <div class="bg-gray-900 rounded-2xl p-8 md:p-12 text-center text-white">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Find the right AI tool for your workflow</h2>
      <p class="text-gray-400 mb-6 max-w-xl mx-auto">
        We've tested {reviews.length}+ tools so far. New reviews every week.
      </p>
      <a href="/reviews" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors">
        Start Exploring
      </a>
    </div>
  </section>
</BaseLayout>
