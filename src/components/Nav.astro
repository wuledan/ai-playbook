---
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur-sm border-b border-gray-200">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 text-xl font-bold text-gray-900 no-underline">
        <span class="text-blue-600">AI</span>Playbook
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-6">
        <a href="/reviews" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Reviews</a>
        <a href="/tutorials" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Tutorials</a>
        <a href="/comparisons" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Comparisons</a>
        <a href="/categories" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Categories</a>
        <a href="/about" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">About</a>
      </div>

      <!-- Search + Mobile Menu -->
      <div class="flex items-center gap-3">
        <a href="/search" class="p-2 text-gray-400 hover:text-gray-600 transition-colors" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
          </svg>
        </a>
        <button id="mobile-menu-btn" class="md:hidden p-2 rounded-lg text-gray-500 hover:text-gray-700" aria-label="Menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M3 12h18M3 6h18M3 18h18"/>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <a href="/reviews" class="block py-2 text-sm font-medium text-gray-600 hover:text-gray-900">Reviews</a>
      <a href="/tutorials" class="block py-2 text-sm font-medium text-gray-600 hover:text-gray-900">Tutorials</a>
      <a href="/comparisons" class="block py-2 text-sm font-medium text-gray-600 hover:text-gray-900">Comparisons</a>
      <a href="/categories" class="block py-2 text-sm font-medium text-gray-600 hover:text-gray-900">Categories</a>
      <a href="/about" class="block py-2 text-sm font-medium text-gray-600 hover:text-gray-900">About</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
