---
import { getCategoryColor } from '../lib/utils';

interface CategoryInfo {
  name: string;
  slug: string;
  count: number;
  colorClass: string;
}

interface Props {
  categories: CategoryInfo[];
  currentCategory?: string;
}

const { categories, currentCategory } = Astro.props;

// Map tailwind color classes to hex for inline styles
const catHexMap: Record<string, string> = {
  'bg-blue-100': '#2563eb',
  'bg-green-100': '#16a34a',
  'bg-purple-100': '#9333ea',
  'bg-pink-100': '#db2777',
  'bg-orange-100': '#ea580c',
  'bg-yellow-100': '#ca8a04',
  'bg-indigo-100': '#4f46e5',
  'bg-gray-100': '#6b7280',
};

function getCatHex(colorClass: string): string {
  const base = colorClass.split(' ')[0];
  return catHexMap[base] || '#2563eb';
}
---

<aside class="hidden lg:block w-56 shrink-0">
  <nav class="sticky top-24">
    <h3 class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Categories</h3>
    <ul class="space-y-1">
      <li>
        <a
          href="/"
          class:list={[
            "flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition-all",
            !currentCategory
              ? "bg-blue-50 text-blue-700"
              : "text-gray-600 hover:bg-gray-50"
          ]}
        >
          <span>All</span>
          <span class="text-xs opacity-60">{categories.reduce((s, c) => s + c.count, 0)}</span>
        </a>
      </li>
      {categories.map((cat) => {
        const hex = getCatHex(cat.colorClass);
        return (
          <li>
            <a
              href={`/categories#${cat.slug}`}
              class:list={[
                "flex items-center justify-between px-3 py-2 rounded-lg text-sm font-medium transition-all",
                currentCategory === cat.name
                  ? "text-white"
                  : "text-gray-600 hover:bg-gray-50"
              ]}
              style={currentCategory === cat.name ? `background-color: ${hex}; color: white` : ''}
            >
              <span class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full shrink-0" style={`background-color: ${hex}`} />
                {cat.name}
              </span>
              <span class="text-xs opacity-60">{cat.count}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>
