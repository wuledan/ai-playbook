ust be at least {min} characters\",\"max_length\":\"Must be no more than {max} characters\",\"exact_length\":\"Must be exactly {length} characters\",\"digits_only\":\"Must contain only digits\"}},\"webinar_form\":{\"fields\":{\"firstname\":{\"label\":\"First Name\",\"placeholder\":\"First name\"},\"lastname\":{\"label\":\"Last Name\",\"placeholder\":\"Last name\"},\"email\":{\"label\":\"Company Email\",\"placeholder\":\"you@company.com\"},\"company\":{\"label\":\"Company Name\",\"placeholder\":\"Company name\"},\"website\":{\"label\":\"Company Website\",\"placeholder\":\"https://company.com\"},\"jobtitle\":{\"label\":\"Job Title\",\"placeholder\":\"Job title\"},\"linkedin__c\":{\"label\":\"LinkedIn\",\"placeholder\":\"https://linkedin.com/in/yourprofile\"},\"phone\":{\"label\":\"Phone Number\",\"placeholder\":\"123 456 7890\"},\"country\":{\"label\":\"Country\"}},\"buttons\":{\"submit\":\"Watch Now\",\"submitting\":\"Submitting...\"},\"errors\":{\"submission_failed\":\"Failed to submit. Please try again.\"}},\"professor_impact_form\":{\"dialog\":{\"button\":\"Apply to join\",\"title\":\"Apply as a Professor\",\"description\":\"Tell us about your institution and use case. We will review your submission and follow up by email.\",\"success_title\":\"Application Received\",\"success_message\":\"Thank you for applying! If you are a good fit for the program, we will reach out to you via email shortly.\",\"success_button\":\"Done\"},\"fields\":{\"first_name\":{\"label\":\"First Name\",\"placeholder\":\"First name\"},\"last_name\":{\"label\":\"Last Name\",\"placeholder\":\"Last name\"},\"email\":{\"label\":\"Your Email\",\"placeholder\":\"you@company.com\"},\"institution\":{\"label\":\"Institution / School\",\"placeholder\":\"Include department or program\"},\"website\":{\"label\":\"Website\",\"placeholder\":\"Personal site, lab page, or course page\"},\"use_case\":{\"label\":\"How are you interested in using ElevenLabs?\",\"placeholder\":\"Briefly describe the course, project, or research context.\"},\"student_access\":{\"label\":\"Do your students need access? If so, how many students are in your class and how long is the course or project?\",\"placeholder\":\"Note: all students must be 18+ to use our platform.\"},\"referral_source\":{\"label\":\"Where did you hear about this program?\",\"unselectedLabel\":\"Select an option\"},\"referral_source_other\":{\"label\":\"Please explain\",\"placeholder\":\"Please tell us how you heard about this program\"},\"featured_consent\":{\"label\":\"I am comfortable being featured as part of ElevenLabs' public educator community.\"},\"terms\":{\"label\":\"By submitting your application and checking the box, you: (i) agree to our \u003ctermsLink\u003eImpact Program for Professors Terms \u0026 Conditions\u003c/termsLink\u003e and \u003cprivacyPolicy\u003ePrivacy Policy\u003c/privacyPolicy\u003e; and (ii) consent to ElevenLabs processing your application and any personal data included in accordance with our \u003cprivacyPolicy\u003ePrivacy Policy\u003c/privacyPolicy\u003e.\"}},\"fieldOptions\":{\"referral_source\":{\"elevenlabs_website\":\"ElevenLabs website\",\"professor_colleagues\":\"Professor colleagues\",\"students\":\"Students\",\"social_media\":\"Social media\",\"other\":\"Other\"}},\"buttons\":{\"submit\":\"Submit Application\",\"submitting\":\"Submitting...\"},\"errors\":{\"submission_failed\":\"Failed to submit. Please try again.\"}},\"play_name\":\"Play - {name}\",\"pause_name\":\"Pause - {name}\",\"chat_transcript\":{\"message_aria_label\":\"Transcript message from {speaker_name}\"},\"BlockStickyContentList\":{\"StudioEditorDemo\":{\"aria_label\":\"Studio editor interface demo\"},\"VoiceChangerPanDemo\":{\"aria_label\":\"Voice changer interface demo\"}},\"MusicFinetuneUIDemo\":{\"aria_label\":\"Music finetune browser demo\"},\"MockDashboards\":{\"StudioEditor\":{\"type\":\"Type\",\"text\":\"Text\",\"voice\":\"Voice\",\"ai_tools\":\"AI Tools\",\"remove_background\":\"Remove background\",\"v