ry again.\",\"error_image_too_large\":\"This image is too large to upscale further.\",\"error_generation_refused\":\"Your request could not be processed due to content policy. Try adjusting your input.\",\"error_cms_unreachable\":\"The service is temporarily unavailable. Please try again later.\",\"error_file_too_large\":\"File is too large. Maximum size is {maxSize}MB.\",\"error_video_too_long\":\"Video is too long. Maximum duration is {maxDuration}s.\",\"error_file_invalid_type\":\"This file type is not supported.\",\"error_text_required\":\"Please describe what you want to generate\",\"quota_title\":\"Generation complete!\",\"quota_description\":\"Sign up for free to download it, continue editing, or access additional tools.\",\"quota_button\":\"Sign up to download\",\"rate_limit_title\":\"You've used all free generations\",\"rate_limit_description\":\"Create a free account to unlock more generations and access all creative tools.\",\"rate_limit_button\":\"Sign up for free\",\"rate_limit_button_video\":\"Sign up to generate\",\"rate_limit_media_message\":\"Free generations used\",\"rate_limit_title_video\":\"Sign up to generate videos\",\"rate_limit_description_video\":\"Create an account to generate videos and access all creative tools.\",\"rate_limit_media_message_video\":\"Sign up to unlock\",\"try_another\":\"Try another\",\"paste_link\":\"Paste link\",\"running_workflow\":\"Running workflow...\",\"signup_popover_title\":\"Claim your creation\",\"signup_popover_feature_1\":\"Download your generated images in full quality\",\"signup_popover_feature_2\":\"Access all creative AI tools and models\",\"signup_popover_feature_3\":\"Generate more images and videos for free\",\"signup_popover_cta\":\"Sign up for free\",\"usage_disclaimer\":\"By using this tool you agree to our \u003ctermsLink\u003eTerms of Service\u003c/termsLink\u003e. To learn more about how ElevenLabs handles your data, check our \u003cprivacyLink\u003ePrivacy Policy\u003c/privacyLink\u003e.\"},\"RandomFact\":{\"random_fact_did_you_know\":\"Did you know?\",\"random_fact_1\":\"ElevenLabs was founded in 2022 by Piotr and Mati, who met at a hackathon.\",\"random_fact_2\":\"ElevenLabs can clone a voice from just a few seconds of audio.\",\"random_fact_3\":\"ElevenLabs supports speech generation in 32 languages.\",\"random_fact_4\":\"The Reader app can turn any text — articles, PDFs, books — into audio.\",\"random_fact_5\":\"The Voice Library has thousands of community-created voices you can use.\",\"random_fact_6\":\"The Projects feature can turn entire books into multi-voice audiobooks.\",\"random_fact_7\":\"ElevenLabs' voice AI has been used to dub movies and TV shows across languages.\",\"random_fact_8\":\"The Sound Effects model can generate any sound from a text description.\",\"random_fact_9\":\"ElevenLabs offers a Conversational AI platform to build voice-powered agents.\",\"random_fact_10\":\"The music model can compose original tracks from a text prompt.\"},\"hero_video_showcase\":{\"play_video\":\"Play video: {title}\",\"mute\":\"Mute\",\"unmute\":\"Unmute\"},\"AudioPlayerBar\":{\"play\":\"Play\",\"pause\":\"Pause\",\"edit_prompt\":\"Edit prompt\",\"download\":\"Download\"},\"AudioGenerationWidget\":{\"submit\":\"Submit\",\"minimize\":\"Minimize\",\"generating\":\"Generating...\",\"generate_new\":\"Generate new\",\"sign_up\":\"Sign up\",\"play\":\"Play\",\"pause\":\"Pause\",\"download\":\"Download\",\"generation\":\"Generation {number}\"},\"CategoryExploreList\":{\"generate_cta_button\":\"Generate\",\"generate_footer_button\":\"Generate your own\"},\"MusicGenerationWidget\":{\"create_your_own_music\":\"Create your own music\",\"generate_music\":\"Generate Music\",\"describe_music\":\"Describe the music you want to create...\"},\"MusicExploreList\":{\"generate_your_own_music\":\"Generate your own music\"},\"MusicCategories\":{\"search\":{\"placeholder\":\"Search music genres…\",\"ariaLabel\":\"Search music categories\",\"suggestionsLabel\":\"Similar:\",\