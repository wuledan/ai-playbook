\":\"697a0ac14bedaf000193e67b\"},{\"language\":\"hr\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/user/Pqevx83RzfcSiL8B6xWJ034oVoy1/voices/MFZUKuGQUsGJPQjTS4wC/fc017964-d05b-429f-9902-5cb8b77dc95f.mp3\",\"id\":\"697a0ac14bedaf000193e67c\"},{\"language\":\"fr\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/user/Pqevx83RzfcSiL8B6xWJ034oVoy1/voices/MFZUKuGQUsGJPQjTS4wC/cfec9443-bda0-4fe2-9c1f-74a689936876.mp3\",\"id\":\"697a0ac14bedaf000193e67d\"},{\"language\":\"en-southern-accent\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/user/Pqevx83RzfcSiL8B6xWJ034oVoy1/voices/MFZUKuGQUsGJPQjTS4wC/37a7f901-39e7-4d6d-b718-b7c4c47ea3d9.mp3\",\"id\":\"697a0ac14bedaf000193e67e\"},{\"language\":\"ta\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/user/Pqevx83RzfcSiL8B6xWJ034oVoy1/voices/MFZUKuGQUsGJPQjTS4wC/37a7f901-39e7-4d6d-b718-b7c4c47ea3d9.mp3\",\"id\":\"697a0ac14bedaf000193e67f\"},{\"language\":\"da\",\"previewUrl\":\"https://storage.googleapis.com/eleven-public-prod/database/user/Pqevx83RzfcSiL8B6xWJ034oVoy1/voices/MFZUKuGQUsGJPQjTS4wC/a2d9209a-f828-4274-9e8f-5af9d294c829.mp3\",\"id\":\"697a0ac14bedaf000193e680\"}]}],\"initialLanguage\":\"en\",\"initialText\":\"In the ancient land of Eldoria, where skies shimmered and forests, whispered secrets to the wind, lived a dragon named Zephyros. [sarcastically] Not the “burn it all down” kind... [giggles] but he was gentle, wise, with eyes like old stars. [whispers] Even the birds fell silent when he passed.\",\"code\":{\"ts\":{\"code\":\"import { ElevenLabsClient } from \\\"@elevenlabs/elevenlabs-js\\\";\\n\\nconst elevenlabs = new ElevenLabsClient();\\nconst audio = await elevenlabs\\n  .textToSpeech.convert(\\\"__VOICE__\\\", {\\n    text: \\\"__TEXT__\\\",\\n    modelId: \\\"eleven_v3\\\",\\n    languageCode: \\\"__LANGUAGE__\\\",\\n  });\",\"quotes\":\"double\",\"tokens\":[[[\"import\",\"#F41A2F\"],[\" { Elev