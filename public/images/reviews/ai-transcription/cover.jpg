<span style="color:#F41A2F">await</span> client.textToSpeech.convert(<span style="color:#052F70">"JBFqnCBsd6RMkjVDRZzb"</span>, {
<span style="color:#0A59D2">  outputFormat:</span><span style="color:#052F70"> "mp3_44100_128"</span>,
<span style="color:#0A59D2">  text:</span><span style="color:#052F70"> "The first move is what sets everything in motion."</span>,
<span style="color:#0A59D2">  modelId:</span><span style="color:#052F70"> "eleven_multilingual_v2"</span>,
});</code></pre><div class="tw-sticky tw-right-0 tw-w-6 tw-flex-none tw-ml-12" style="background:linear-gradient(to left, rgba(255, 255, 255, 1) 0%, rgba(255, 255, 255, 0.98726) 8.07%, rgba(255, 255, 255, 0.95141) 15.54%, rgba(255, 255, 255, 0.896) 22.5%, rgba(255, 255, 255, 0.82459) 29.04%, rgba(255, 255, 255, 0.74074) 35.26%, rgba(255, 255, 255, 0.648) 41.25%, rgba(255, 255, 255, 0.54993) 47.1%, rgba(255, 255, 255, 0.45007) 52.9%, rgba(255, 255, 255, 0.352) 58.75%, rgba(255, 255, 255, 0.25926) 64.74%, rgba(255, 255, 255, 0.17541) 70.96%, rgba(255, 255, 255, 0.104) 77.5%, rgba(255, 255, 255, 0.04859) 84.46%, rgba(255, 255, 255, 0.01274) 91.93%, rgba(255, 255, 255, 0) 100%)"></div></div><div class="tw-absolute tw-isolate tw-top-3 tw-right-3 [@media(hover:hover)]:tw-opacity-0 group-hover/code:tw-opacity-100 group-has-[:focus]/code:tw-opacity-100 tw-transition-opacity"><div class="tw-absolute -tw-z-10 -tw-bottom-6 -tw-left-6 tw-size-24" style="background:radial-gradient(50% 50% at center, #fff calc(100% - 1rem), #fff0)"></div><button type="button" class="tw-rounded-full tw-size-9 tw-flex tw-items-center tw-justify-center tw-transition-colors tw-outline-none focus-visible:tw-outline-focus tw-bg-gray-50 hover:tw-bg-gray-100" aria-label="Copy"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="tw-size-5 [&amp;_*]:[vector-effect:non-scaling-stroke]"><path d="M15.25 15.25V20C15.25 20.6904 14.6904 21.25 14 21.25H4C3.30964 21.25 2.75 20.6904 2.75 20V10C2.75 9.30964 3.30964 8.75 4 8.75H8.75M10 15.25H20C20.6904 15.25 21.25 14.6904 21.25 14V4C21.25 3.30964 20.6904 2.75 20 2.75H10C9.30964 2.75 8.75 3.30964 8.75 4V14C8.75 14.6904 9.30964 15.25 10 15.25Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></button></div></div></div></div></div></div></div></div><div class="block-section" style="--marker-background-color:#FDFCFC"><div class="container relative border-l border-r border-overlay-dark"><div class=""><div cla